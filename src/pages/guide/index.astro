---
import Base from '../../layouts/Base.astro';
import LogHeader from '../../components/LogHeader.astro';
import Sources from '../../components/Sources.astro';
import Photo from '../../components/Photo.astro';
import { guidePages } from '../../lib/content';
import { destinationNode } from '../../lib/schema.mjs';
import { formatCoord, isoDate } from '../../lib/format.mjs';
import { site } from '../../../site.config.mjs';

const pages = await guidePages();
const latest = pages.reduce((m, e) => (e.data.reviewed > m ? e.data.reviewed : m), pages[0]?.data.reviewed ?? new Date());
const earliest = pages.reduce((m, e) => (e.data.published < m ? e.data.published : m), pages[0]?.data.published ?? new Date());
const description = 'A reference guide to Antarctica as a travel destination: regions, the season month by month, departure ports, the Drake Passage, ship sizes, the Antarctic Circle and packing.';
---
<Base title="Antarctica destination guide" description={description} path="/guide" crumbs={[{ name: 'Guide', href: '/guide' }]} schema={[destinationNode()]}>
  <div class="page wide">
    <div class="margin">
      <LogHeader entry="Guide · index" published={earliest} reviewed={latest} position={formatCoord(site.geo.lat, site.geo.lon)} />
    </div>
    <div class="body">
      <h1>Antarctica destination guide</h1>
      <p class="lede">Antarctica is not a country. It is a continent governed under the Antarctic Treaty, reached by ship or by plane from the southern tip of South America and, less often, from New Zealand and Australia.</p>
      <p>Each guide page shows when it was published, when it was last reviewed, and the sources behind it. The two reference tables, the <a href="/season">season chart</a> and the <a href="/compare">port and route comparison</a>, sit on their own pages.</p>
      {pages.length === 0 ? <p class="empty">No guide pages have been reviewed for publication yet.</p> : (
        <>
        <div class="rule-head"><h2>All guide pages</h2><span>{pages.length} pages</span></div>
        <div class="stories">
          <a class="story lead" href={`/guide/${pages[0].id}`}>
            {pages[0].data.image && <Photo name={pages[0].data.image} caption={false} aspect="4 / 3" sizes="(min-width: 64rem) 40vw, 100vw" widths={[480, 720, 960]} />}
            <p class="meta"><span>Guide 01</span><span>Reviewed {isoDate(pages[0].data.reviewed)}</span></p>
            <h3>{pages[0].data.title}</h3>
            <p>{pages[0].data.description}</p>
          </a>
          <ol class="story-list">
            {pages.slice(1).map((e, i) => (
              <li><a href={`/guide/${e.id}`} class:list={[!e.data.image && 'noimg']}>
                <p class="meta"><span>Guide {String(i + 2).padStart(2, '0')}</span><span>Reviewed {isoDate(e.data.reviewed)}</span></p>
                <h3>{e.data.title}</h3>
                {e.data.image && <Photo name={e.data.image} caption={false} aspect="1 / 1" sizes="104px" widths={[120, 220]} />}
              </a></li>
            ))}
          </ol>
        </div>
        </>
      )}
      <Sources sources={[{ url: 'https://www.ats.aq/e/antarctictreaty.html', label: 'Secretariat of the Antarctic Treaty: The Antarctic Treaty' }]} />
    </div>
  </div>
</Base>
